# Frontend environment template. Every value here is public: Vite substitutes VITE_* variables
# into the bundle at build time, so anyone who loads the page can read them. Never add a client
# secret, admin credential, token, password, or user credential to this file or to .env.

# Authentication mode. Optional, client-runtime; defaults to legacy_session when unset or
# unrecognised. legacy_session uses the Spring register/login/session flow; keycloak_jwt opts
# into Authorization Code + PKCE through the public client configured below.
VITE_AUTHENTICATION_MODE=legacy_session

# Product API base for browser requests. Optional, client-runtime. Blank is the intended local
# and Docker default: requests stay same-origin and the dev-server or deployment proxy owns
# backend routing. Set it only where the API is served from another origin.
VITE_API_BASE_URL=

# Backend address shown in the UI. Optional, client-runtime; falls back to VITE_API_BASE_URL,
# then to http://localhost:8081.
VITE_API_DISPLAY_URL=http://localhost:8081

# Dev-server proxy target for /api and /health. Optional, build-time only: read by
# vite.config.ts, never by the client. Falls back to VITE_API_DISPLAY_URL, then to
# http://localhost:8081. docker-compose.yml overrides it with http://host.docker.internal:8081
# so the container can reach the host backend.
VITE_API_PROXY_TARGET=http://localhost:8081

# Local development Keycloak public-client settings.
# Used only when VITE_AUTHENTICATION_MODE=keycloak_jwt.
# Client-runtime; required in that mode, ignored in legacy_session.
# Do not add client secrets, admin credentials, tokens, passwords, or user credentials here.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=workspace-dev
VITE_KEYCLOAK_CLIENT_ID=workspace-web

# Optional build metadata: a short revision string identifying the running build, shown in
# Settings -> Diagnostics. Build-time only: vite.config.ts reads it, trims it to 40 characters
# and injects it as __APP_REVISION__; it is never read from the running browser environment.
# Absent or blank leaves it empty and Settings shows "unknown". Public once embedded, so it
# carries a revision string and nothing else. Set it from the build or deployment process.
# VITE_APP_REVISION=
